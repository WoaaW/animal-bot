DISCORD_TOKEN=your_bot_token_here
# Optional: prefix for text commands (default "!"). Slash commands always work.
# COMMAND_PREFIX=!
# Optional: the stats website (python -m bot.web). 127.0.0.1 keeps it on this
# machine; 0.0.0.0 opens it to the network.
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# Optional: "Sign in with Discord" on the website, so only members of a server
# see its data. Both from the Developer Portal (OAuth2 page of the bot's app);
# also add <WEB_BASE_URL>/auth/callback under OAuth2 → Redirects there.
# Without them the site is open to anyone who can reach it.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# WEB_BASE_URL=https://your-public-address

# Mentioning the bot gets an answer from a local Ollama model (optional).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:0.5b
